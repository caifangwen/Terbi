{% liquid
  assign items = blank

  if section.settings.content_source == 'selected'
    assign items = section.settings.items

  else
    if page != blank
      assign items = page.metafields.custom.feature_section.value

    elsif collection != blank
      assign source_collection = section.settings.source_collection | default: collection
      assign items = source_collection.metafields.custom.feature_section.value
    endif
  endif
%}

{% if items != blank %}
  <section
    class="collection-feature-section"
    style="--image-with-text-ratio: {{ section.settings.image_ratio | default: '4 / 3' }};"
  >
    {% for item in items %}
      {% liquid
        assign image_position = forloop.index0 | modulo: 2

        assign title = item.title.value
        assign image = item.image.value
        assign description = item.description.value
      %}

      <article
        class="
          collection-feature
          {% if image_position == 1 %}
            collection-feature--image-left
          {% endif %}
        "
      >
        <div class="collection-feature__content">
          {% if title != blank %}
            <h2 class="collection-feature__title">
              {{ title }}
            </h2>
          {% endif %}

          <div class="collection-feature__cards">
            {% for index in (1..3) %}
              {% capture feature_key %}
                feature_{{ index }}
              {% endcapture %}

              {% capture detail_key %}
                feature_detail_{{ index }}
              {% endcapture %}

              {% assign feature_key = feature_key | strip %}
              {% assign detail_key = detail_key | strip %}

              {% assign feature = item[feature_key].value %}
              {% assign detail = item[detail_key].value %}

              {% if feature != blank or detail != blank %}
                <div class="collection-feature__card">
                  {% if feature != blank %}
                    <h3 class="collection-feature__card-title">
                      {{ feature }}
                    </h3>
                  {% endif %}

                  {% if detail != blank %}
                    <p class="collection-feature__card-detail">
                      {{ detail | escape | newline_to_br }}
                    </p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>

          {% if description != blank %}
            <div class="collection-feature__description">
              {{ description | escape | newline_to_br }}
            </div>
          {% endif %}
        </div>

        {% if image != blank %}
          <div class="collection-feature__media">
            {{
              image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '480, 720, 960, 1200, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                class: 'collection-feature__image',
                alt: title
            }}
          </div>
        {% endif %}
      </article>
    {% endfor %}
  </section>
{% endif %}

{% style %}
  .collection-feature-section { width: 100%; min-width: 0; margin: 0 auto;  }
  .collection-feature { display: grid; grid-template-columns: minmax(0, 1fr) minmax(36rem, 1fr); gap: clamp(3.2rem, 6vw, 8.8rem); align-items: center; padding-block: clamp(3.2rem, 4vw, 4.8rem); }
  .collection-feature--image-left .collection-feature__content { order: 2; }
  .collection-feature--image-left .collection-feature__image { order: 1; }
  .collection-feature h2 { margin: 0 0 2.8rem; color: var(--shed-text, var(--color-foreground)); font-size: clamp(2.8rem, 3vw, 4.8rem); line-height: 1.08; letter-spacing: -0.04em; }
  .collection-feature__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem; }
  .collection-feature__card { padding: 0 1.6rem; text-align: left; border-inline-start: 0.1rem solid var(--shed-border, rgb(var(--color-foreground-rgb) / 0.07)); }
  .collection-feature__card:first-child { padding-inline-start: 0; border-inline-start: 0; }
  .collection-feature__card h3 { margin: 0 0 0.6rem; color: var(--shed-text, var(--color-foreground)); font-size: 1.6rem; }
  .collection-feature__card p, .collection-feature__description { margin: 0; color: var(--shed-muted, rgb(var(--color-foreground-rgb) / 0.64)); line-height: 1.55; }
  .collection-feature__description { margin-top: 2.8rem; max-width: 62ch; font-size: 1.7rem; }
  .collection-feature__image { display: block; width: 100%; height: auto; aspect-ratio: var(--image-with-text-ratio, 4 / 3); object-fit: cover; border-radius: var(--shed-radius, 0.8rem); box-shadow: var(--shed-card-shadow, 0 1rem 2.6rem rgb(var(--color-foreground-rgb) / 0.055)); }
  @media screen and (max-width: 749px) {
    .collection-feature-section { padding-block: 0; }
    .collection-feature { grid-template-columns: 1fr; gap: 2.4rem; }
    .collection-feature--image-left .collection-feature__content { order: initial; }
    .collection-feature__image, .collection-feature--image-left .collection-feature__image { order: -1; }
    .collection-feature__cards { grid-template-columns: 1fr; }
    .collection-feature__card, .collection-feature__card:first-child { padding: 1.6rem 0; border-block-start: 0.1rem solid var(--shed-border, rgb(var(--color-foreground-rgb) / 0.07)); border-inline-start: 0; }
    .collection-feature__card:first-child { padding-block-start: 0; border-block-start: 0; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Feature list",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "content_source",
      "label": "Data source",
      "default": "resource",
      "options": [
        {
          "value": "resource",
          "label": "Current page / collection metafield"
        },
        {
          "value": "selected",
          "label": "Selected metaobjects"
        }
      ]
    },
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Source collection",
      "info": "Optional. On collection pages, leave blank to use the current collection. This setting is ignored on pages."
    },
    {
      "type": "metaobject_list",
      "id": "items",
      "label": "Content entries",
      "metaobject_type": "feature_section"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "auto",
          "label": "Original"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        }
      ],
      "default": "4 / 3"
    }
  ],
  "presets": [
    {
      "name": "Feature list",
      "category": "Basic"
    }
  ]
}
{% endschema %}
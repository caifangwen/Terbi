{% liquid
  assign cards = section.blocks
  assign source_collection = section.settings.source_collection | default: collection
  if section.settings.content_source == 'selected'
    assign cards = nil
    assign items = section.settings.items
  else
    assign items = source_collection.metafields.custom.shop_by.value
  endif
%}
{% if items != blank or cards.size > 0 %}
  <div class="section section--page-width spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {% render 'shop-by', shop_by_entries: items, cards: cards, heading: section.settings.heading, all_label: section.settings.all_label, all_link: section.settings.all_link %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Shop by",
  "enabled_on": {
    "templates": ["index", "collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "View all label",
      "default": "Explore All Collections"
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "View all link"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Data source",
      "default": "collection",
      "options": [
        {
          "value": "collection",
          "label": "Collection metafield"
        },
        {
          "value": "selected",
          "label": "Selected metaobjects"
        }
      ]
    },
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Source collection",
      "info": "Leave blank to use the current collection."
    },
    {
      "type": "metaobject_list",
      "id": "items",
      "label": "Content entries",
      "metaobject_type": "shop_by"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by"
    }
  ]
}
{% endschema %}

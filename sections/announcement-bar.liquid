<announcement-bar
  class="group-block block page-width group-block--{{ section.id }} color-{{ section.settings.color_scheme }}"
  style="--pt:{{ section.settings.padding_top }}px; --pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="group-block page-width utility-bar__grid flex-section w-full flex flex-row flex-wrap items-center justify-center utility-bar">
    {% if section.blocks.size > 1 %}
      <swiper-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'content.carousel' | t }}"
        aria-label="{{ 'content.announcement_bar' | t }}"
        {% render 'swiper-data', settings: section.settings, slides_per_view: 1, space_between: 0, watch_slides_progress: true, autoplay: section.settings.autoplay, effect: 'fade', autoplay_speed: section.settings.autoplay_speed %}
        style="{% render 'swiper-style', columns_mobile: 1, columns_tablet: 1, columns_desktop: 1, columns_gap: 0 %}"
      >
    {% else %}
      <div class="announcement-bar">
    {% endif %}
      <div class="announcement-bar-slider swiper">
        <div class="swiper-wrapper grid grid-layout grid-layout--1 list-unstyled" id="Slider-{{ section.id }}" aria-live="polite" aria-atomic="true">
          {% content_for 'blocks' %}
        </div>
        {% if section.blocks.size > 1 %}{% render 'swiper-button' %}{% endif %}
      </div>
    {% if section.blocks.size > 1 %}</swiper-component>{% else %}</div>{% endif %}
  </div>
</announcement-bar>

{% if request.design_mode and section.blocks.size > 0 %}<script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>{% endif %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "class": "section-header section-announcement-bar",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "blocks": [{ "type": "@app" }, { "type": "_announcement-text" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.auto_rotate_announcements",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:settings.change_every",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.spacing_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "t:settings.top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "t:settings.bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "category": "t:categories.storytelling",
      "blocks": {
        "announcement_text_hGknhk": {
          "type": "_announcement-text",
          "settings": {
            "text": "End of season sale up to 50% off. <a href=\"/collections\" title=\"All collections\">Shop Now</a>",
            "font": "body",
            "font_size": "1.4rem"
          },
          "blocks": {}
        },
        "announcement_text_EYmrCA": {
          "type": "_announcement-text",
          "settings": { "text": "Welcome to our store", "font": "body", "font_size": "1.4rem" },
          "blocks": {}
        },
        "announcement_text_dLXHXE": {
          "type": "_announcement-text",
          "settings": { "text": "Welcome to our store", "font": "body", "font_size": "1.4rem" },
          "blocks": {}
        }
      },
      "block_order": [
        "announcement_text_hGknhk",
        "announcement_text_EYmrCA",
        "announcement_text_dLXHXE"
      ],
      "settings": {
        "color_scheme": "scheme-3",
        "autoplay": false,
        "autoplay_speed": 5,
        "margin_bottom": 0,
        "padding_top": 15,
        "padding_bottom": 15
      }
    }
  ]
}
{% endschema %}

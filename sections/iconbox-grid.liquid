{% assign items = collection.metafields.custom.iconbox.value %}

{% if items != blank %}
  <div
    class="iconbox-grid"
    style="--iconbox-columns: 3; --iconbox-columns-mobile: 1; --iconbox-gap: 24px;"
  >
    {% if items != blank %}
      {% for item in items %}
        {% assign heading = item.heading.value | default: item.heading %}
        {% assign description = item.description.value | default: item.description %}
        {% assign image = item.image.value | default: item.image %}

        <article class="iconbox">
          {% if image != blank %}
            {{ image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '72, 120, 160', class: 'iconbox__image', alt: 'Icon box' }}
          {% endif %}
          <div class="iconbox__content">
            {% if heading != blank %}<h3 class="iconbox__heading">{{ heading }}</h3>{% endif %}
            {% if description != blank %}<div class="iconbox__description">{{ description | escape | newline_to_br }}</div>{% endif %}
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
{% endif %}

{% style %}
  .iconbox-grid {
    width: 100%; min-width: 0;
    margin: 0 auto;
    padding-block: clamp(3.2rem, 4vw, 4.8rem);
    display: grid;
    grid-template-columns: repeat(var(--iconbox-columns), minmax(0, 1fr));
    gap: clamp(1.6rem, 2vw, 2.4rem);
  }
  .iconbox { min-width: 0; padding: 0 2.4rem; border-inline-start: 0.1rem solid var(--shed-border, rgb(var(--color-foreground-rgb) / 0.07)); }
  .iconbox:nth-child(3n + 1) { padding-inline-start: 0; border-inline-start: 0; }
  .iconbox__image { display: block; width: 5.6rem; max-width: 100%; height: auto; object-fit: contain; }
  .iconbox__heading { margin: 1.6rem 0 0.8rem; color: var(--shed-text, var(--color-foreground)); font-size: 1.8rem; line-height: 1.2; letter-spacing: -0.025em; }
  .iconbox__description { color: var(--shed-muted, rgb(var(--color-foreground-rgb) / 0.64)); font-size: 1.4rem; line-height: 1.6; }
  @media screen and (max-width: 749px) {
    .iconbox-grid { grid-template-columns: repeat(var(--iconbox-columns-mobile), minmax(0, 1fr)); }
    .iconbox { padding: 1.6rem 0; border-block-start: 0.1rem solid var(--shed-border, rgb(var(--color-foreground-rgb) / 0.07)); border-inline-start: 0; }
    .iconbox:first-child { border-block-start: 0; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Icon box grid",
  "class": "section",
  "presets": [
    {
      "name": "Icon box grid",
      "category": "Basic"
    }
  ]
}
{% endschema %}

{% liquid
  assign cta = page.metafields.custom.cta.value
  assign heading = cta.heading.value | default: cta.heading
  assign content = cta.content.value | default: cta.content
  assign button = cta.button.value | default: cta.button
  assign link_value = cta.link.value | default: cta.link
  assign link = link_value.url | default: link_value
%}

{% if cta != blank %}
  <section class="section page-cta section--page-width">
    <div class="page-cta__content">
      {% if heading != blank %}
        <h2 id="page-cta-{{ section.id }}" class="page-cta__heading">{{ heading | escape }}</h2>
      {% endif %}

      {% if content != blank %}
        <div class="page-cta__text">{{ content | escape | newline_to_br }}</div>
      {% endif %}

      {% if button != blank and link != blank %}
        <a class="button page-cta__button" href="{{ link | escape }}">
          <span class="button-overflow relative overflow-hidden" data-button-text="{{ button | escape }}">
            <span class="button-text-main inline-block relative z-1">{{ button | escape }}</span>
          </span>
        </a>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}

  .page-cta {
    padding-block: clamp(2.4rem, 5vw, 4.8rem);
  }

  .page-cta__content {
    width: 100%;
    margin-inline: auto;
    padding: clamp(3rem, 5vw, 5rem) clamp(2rem, 4vw, 4rem);

    text-align: center;
    color: var(--color-background);
    background-color: var(--color-primary);

    border-radius: 0.8rem;
  }

  .page-cta__heading {
    margin: 0;

    color: inherit;
    font-size: clamp(2.8rem, 4vw, 4.4rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .page-cta__text {
    max-width: 60rem;
    margin: 1.2rem auto 0;

    color: rgb(var(--color-background-rgb) / 0.78);
    font-size: clamp(1.5rem, 1.4vw, 1.7rem);
    line-height: 1.65;
  }

  .page-cta__button {
    --button-color: var(--color-primary);
    --button-background-color: var(--color-background);
    --button-border-color: var(--color-background);

    margin-top: 2.4rem;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Page CTA",
  "settings": []
}
{% endschema %}

<script>
  (() => {
    const root = document.getElementById({{ section_id | json }});
    if (!root) return;

    const tabs = root.querySelectorAll('[data-assembly-tab]');
    const panels = root.querySelectorAll('[data-assembly-panel]');
    const modal = root.querySelector('.assembly-manuals__modal');
    const iframe = root.querySelector('.assembly-manuals__modal iframe');
    const closeButton = root.querySelector('.assembly-manuals__close');

    const toEmbedUrl = (url) => {
      try {
        const parsed = new URL(url);
        if (parsed.hostname.includes('youtube.com') && parsed.searchParams.get('v')) {
          return `https://www.youtube.com/embed/${parsed.searchParams.get('v')}`;
        }
        if (parsed.hostname.includes('youtu.be')) {
          return `https://www.youtube.com/embed/${parsed.pathname.replace('/', '')}`;
        }
      } catch (error) {
        return url;
      }

      return url;
    };

    const switchTab = (index) => {
      tabs.forEach((tab, tabIndex) => {
        const isActive = tabIndex === index;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
      });

      panels.forEach((panel, panelIndex) => {
        panel.classList.toggle('is-active', panelIndex === index);
      });
    };

    const closeModal = () => {
      if (!modal || !iframe) return;
      modal.hidden = true;
      iframe.src = '';
      document.body.style.overflow = '';
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => switchTab(index));
    });

    root.addEventListener('click', (event) => {
      const button = event.target.closest('[data-video-url]');
      if (!button || !modal || !iframe) return;

      iframe.src = toEmbedUrl(button.dataset.videoUrl);
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    });

    closeButton?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeModal();
    });
  })();
</script>

{% schema %}
{
  "name": "Assembly manuals",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shed Assembly & Downloads"
    },
    {
      "type": "text",
      "id": "tab_label",
      "label": "Tab label",
      "default": "Choose Product"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Product collections",
      "info": "Select the collections whose products should appear in this manual list."
    },
    {
      "type": "text",
      "id": "pdf_label",
      "label": "PDF button label",
      "default": "Installation PDF"
    },
    {
      "type": "text",
      "id": "video_label",
      "label": "Video button label",
      "default": "Watch Video"
    },
    {
      "type": "checkbox",
      "id": "hide_products_without_manuals",
      "label": "Hide products without PDF or video",
      "default": true
    },
    {
      "type": "text",
      "id": "pdf_metafield_key",
      "label": "PDF metafield key",
      "default": "assembly_manual_pdf",
      "info": "Uses product metafields in the custom namespace."
    },
    {
      "type": "text",
      "id": "video_metafield_key",
      "label": "Video metafield key",
      "default": "assembly_video_url",
      "info": "Uses product metafields in the custom namespace."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "No manuals are available for this collection yet."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Assembly manuals"
    }
  ]
}
{% endschema %}

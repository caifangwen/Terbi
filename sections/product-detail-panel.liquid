{{ 'product-detail-content.css' | asset_url | stylesheet_tag }}

<section
  id="product-detail-{{ section.settings.content_type }}"
  class="product-detail-panel section section--page-width spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {% unless section.settings.content_type == 'reviews' %}
    <h2 class="product-detail-panel__heading">{{ section.settings.heading | escape }}</h2>
  {% endunless %}
  <div class="product-detail-panel__body">
    {% case section.settings.content_type %}
      {% when 'description' %}
        <div class="rte">{{ product.description }}</div>
      {% when 'specifications' %}
        {% capture specification_table %}{% render 'product-specifications', product: product %}{% endcapture %}
        {% assign specification_image = product.metafields.custom.specification_details.value.spec_image.value %}
        <div class="product-detail-panel__specifications{% if specification_table == blank %} product-detail-panel__specifications--image-only{% endif %}">
          {% if specification_table != blank %}
            <div class="product-detail-panel__specification-table">{{ specification_table }}</div>
          {% endif %}
          {% if specification_image != blank %}
            <div class="product-detail-panel__specification-image">
              {{ specification_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
            </div>
          {% endif %}
        </div>
      {% when 'reviews' %}
        <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
          {{ product.metafields.judgeme.widget }}
        </div>
    {% endcase %}
  </div>
</section>

{% schema %}
{
  "name": "Product detail panel",
  "settings": [
    {
      "type": "select",
      "id": "content_type",
      "label": "Content",
      "options": [
        { "value": "description", "label": "Description" },
        { "value": "specifications", "label": "Specification" },
        { "value": "reviews", "label": "Reviews" }
      ],
      "default": "description"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Description"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    { "name": "Product detail panel" }
  ]
}
{% endschema %}

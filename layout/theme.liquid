{%- capture direction -%}
  {%- assign rtl_locales = "ar,ae,arc,fa,he,ur,ps,sd,dv,yi,ug,ha,ckb,ku,ks,pnb,bcc,bqi,azb,mzn,glk,nqo,kwh" | split: "," -%}
  {%- if rtl_locales contains request.locale.iso_code -%}
    rtl
  {%- else -%}
    ltr
  {%- endif -%}
{%- endcapture -%}

<!doctype html>
<html class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}" lang="{{ request.locale.iso_code }}" dir="{% if settings.enable_rtl_layout %}{{ direction }}{% else %}ltr{% endif %}">
  <head>
 {%- capture ecom_header_content -%}{%- render 'ecom-header' -%}{%- endcapture -%}{%- unless ecom_header_content contains 'Liquid error' -%}{{ ecom_header_content }}{%- endunless -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link
      rel="canonical"
      href="{{ canonical_url }}"
      canonical-url="{{ shop.url }}/"
    >

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- assign theme_brand = settings.brand_name | default: shop.name -%}
    <title>
      {%- if request.page_type == 'index' -%}{{ theme_brand | escape }}{%- else -%}{{ page_title | escape }} &ndash; {{ theme_brand | escape }}{%- endif -%}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' | escape }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'content.page' | t }} {{ current_page }}{% endif -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {% render 'global-style' %}

    {% render 'global-css', direction: direction %}

    {%- if template == 'cart' -%}
      {{ 'template-cart-base.css' | asset_url | stylesheet_tag: preload: true }}
    {%- endif -%}
    {%- if template == 'product' -%}
      {{ 'template-product-base.css' | asset_url | stylesheet_tag: preload: true }}
    {%- endif -%}
    {%- if template == 'collection' -%}
      {{ 'template-collection-base.css' | asset_url | stylesheet_tag: preload: true }}
    {%- endif -%}

    {%- render 'global-script' -%}

    {{ content_for_header }}
{% if template == 'collection' and collection.products_count == 0 %}
  <meta name="robots" content="noindex, follow">
{% endif %}
{% comment %} SEO: noindex for 17TRACK app page {% endcomment %}
{% if request.path contains '/apps/17TRACK' %}
  <meta name="robots" content="noindex, nofollow">
{% endif %}

    
  </head>

  <body
    class="
      template-{{ request.page_type | replace: 'customers/', '' }}{% if settings.enable_preloading_screen %} has--preload-screen{% endif %}
      {% if template.suffix != blank %} template-suffix-{{ template.suffix | handle }}{% endif %}
      {% if settings.animations_hover_elements != 'none' %} card-hover--{{ settings.animations_hover_elements }}{% endif %}
      {% if settings.animation_hover_buttons %} button-hover--effect{% endif %}
    "
  >
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'preload-screen' %}

    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    {%- liquid
      sections 'popup-group'
      sections 'general-group'
      sections 'toolbar-mobile'
    -%}

    <main
      id="MainContent"
      class="content-for-layout focus-none relative z-2"
      role="main"
      tabindex="-1"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {% render 'halo-popup' %}

    {%- if settings.show_floating_icons -%}
      <div class="floating-icons" aria-hidden="true" data-floating-speed="{{ settings.floating_icons_speed | default: 100 }}" style="position: fixed; inset: 0; pointer-events: none; z-index: 9999; width: 100%; height: 100%; overflow: hidden; contain: layout paint; transform: translateZ(0); --floating-icons-color: {{ settings.floating_icons_color }};"></div>
      {{ 'floating-icons.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'floating-icons.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    <script src="{{ 'floating-app-launchers.js' | asset_url }}" defer="defer"></script>
  {%- capture ecom_footer_content -%}{%- render 'ecom-footer' -%}{%- endcapture -%}{%- unless ecom_footer_content contains 'Liquid error' -%}{{ ecom_footer_content }}{%- endunless -%}</body>
</html>

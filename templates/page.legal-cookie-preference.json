    "custom_liquid_x6G4X7": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"tk-cookie-prefs page-width rte\">\n  <p><strong>Effective Date:</strong> June 15, 2026<br><strong>Last Updated:</strong> September 29, 2026</p>\n  <p>Choose how TERBI may use optional cookies and similar technologies on this browser or device. For full details, see our <a href=\"/pages/cookie-policy\">Cookie Policy</a>.</p>\n  <p>Strictly necessary technologies always stay on because the store, checkout, account, security, and privacy features need them to work.</p>\n\n  <p>\n    <button type=\"button\" class=\"button\" data-tk=\"accept\">Accept All</button>\n    <button type=\"button\" class=\"button\" data-tk=\"reject\">Reject Non-Essential</button>\n    <button type=\"button\" class=\"button button--secondary\" data-tk=\"save\">Save Preferences</button>\n  </p>\n  <p class=\"tk-msg\" role=\"status\" aria-live=\"polite\"></p>\n\n  <h2>Strictly Necessary</h2>\n  <p><strong>Always Active</strong></p>\n  <p>These technologies support:</p>\n  <ul>\n    <li>website operation;</li>\n    <li>shopping cart and checkout;</li>\n    <li>security and fraud prevention;</li>\n    <li>account sign-in;</li>\n    <li>storing your privacy preferences; and</li>\n    <li>services you specifically request.</li>\n  </ul>\n  <p>They cannot be switched off here.</p>\n\n  <h2>Analytics &amp; Performance</h2>\n  <p><label><input type=\"checkbox\" role=\"switch\" data-cat=\"analytics\"> On / Off</label> · Current status: <span data-status=\"analytics\">No choice recorded</span></p>\n  <p>These technologies help us understand how visitors use the website, measure performance, find technical problems, and improve our products and content. They may process device, browser, interaction, and usage information. Not all analytics data is anonymous.</p>\n\n  <h2>Functional</h2>\n  <p><label><input type=\"checkbox\" role=\"switch\" data-cat=\"preferences\"> On / Off</label> · Current status: <span data-status=\"preferences\">No choice recorded</span></p>\n  <p>These technologies support optional features and remember choices such as:</p>\n  <ul>\n    <li>language;</li>\n    <li>currency;</li>\n    <li>region; and</li>\n    <li>display preferences.</li>\n  </ul>\n  <p>Some optional features may not work as intended if you turn Functional technologies off.</p>\n\n  <h2>Advertising &amp; Targeting</h2>\n  <p><label><input type=\"checkbox\" role=\"switch\" data-cat=\"marketing\"> On / Off</label> · Current status: <span data-status=\"marketing\">No choice recorded</span></p>\n  <p>These technologies may support:</p>\n  <ul>\n    <li>campaign measurement;</li>\n    <li>attribution;</li>\n    <li>showing ads to past visitors;</li>\n    <li>building advertising audiences; and</li>\n    <li>interest-based or targeted advertising.</li>\n  </ul>\n\n  <h2>Sale, Sharing &amp; Targeted Advertising Choices</h2>\n  <p>Turning off advertising cookies is not the only way to opt out of the sale or sharing of personal information or targeted advertising. To exercise those rights where they apply to you, use <a href=\"/pages/data-sharing-opt-out\">Your Privacy Choices</a>.</p>\n\n  <h2>Your Choices Apply to This Browser</h2>\n  <p>Your preferences are saved for the browser or device you use to make them. If you switch browsers or devices, or clear your browser data, you may need to set them again.</p>\n\n  <h2>Related Policies</h2>\n  <p><a href=\"/policies/privacy-policy\">Privacy Policy</a> · <a href=\"/pages/cookie-policy\">Cookie Policy</a> · <a href=\"/pages/data-sharing-opt-out\">Your Privacy Choices</a></p>\n\n  <h2>Contact Us</h2>\n  <p><strong>TERBI INC.</strong><br>4245 N Central Expy, Ste 492<br>Dallas, Texas 75205<br>United States</p>\n  <p>Email: <a href=\"mailto:laser@terkkin.com\">laser@terkkin.com</a></p>\n</div>\n\n<script>\n(function () {\n  var root = document.querySelector('.tk-cookie-prefs');\n  var cats = ['analytics', 'preferences', 'marketing'];\n  var words = { yes: 'Allowed', no: 'Denied' };\n\n  function show() {\n    var c = Shopify.customerPrivacy.currentVisitorConsent() || {};\n    cats.forEach(function (k) {\n      root.querySelector('[data-cat=\"' + k + '\"]').checked = c[k] === 'yes';\n      root.querySelector('[data-status=\"' + k + '\"]').textContent = words[c[k]] || 'No choice recorded';\n    });\n  }\n\n  function save(all) {\n    var v = {};\n    cats.forEach(function (k) {\n      v[k] = all !== undefined ? all : root.querySelector('[data-cat=\"' + k + '\"]').checked;\n    });\n    Shopify.customerPrivacy.setTrackingConsent(v, function () {\n      show();\n      root.querySelector('.tk-msg').textContent = 'Your cookie preferences have been saved.';\n    });\n  }\n\n  Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (err) {\n    if (err) return;\n    show();\n    root.addEventListener('click', function (e) {\n      var b = e.target.closest('[data-tk]');\n      if (!b) return;\n      var a = b.getAttribute('data-tk');\n      save(a === 'accept' ? true : a === 'reject' ? false : undefined);\n    });\n  });\n})();\n</script>",
        "color_scheme": "scheme-11",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }
  },

{%- comment -%}
  Simple mega menu layout.

  Output:
  - menu columns, with an automatic image per column heading
  - featured hot-selling product card from the matched mega menu block collection
{%- endcomment -%}

{%- liquid
  assign bl_stts = block.settings
  assign section_fetch = section_fetch | default: false
  if section.index == nil
    assign section_fetch = true
  endif

  assign columns_count = bl_stts.grid | default: link.links.size | at_most: 5 | at_least: 2
  assign width = bl_stts.width | default: 'page-width'
  assign side_image = bl_stts.image_1
  assign selected_product = bl_stts.featured_product
  assign product_collection = bl_stts.product_collection
  assign side_link = bl_stts.link_url_1
  assign featured_product = blank
  assign featured_card_url = side_link
  assign featured_card_title = link.title
  assign featured_image = side_image
  assign featured_alt = side_image.alt | default: featured_card_title | escape

  if selected_product != blank
    assign featured_product = selected_product
  elsif product_collection != blank
    assign featured_product = product_collection.products | first
  elsif side_link contains '/products/'
    assign featured_handle = side_link | split: '/products/' | last | split: '?' | first
    assign featured_product = all_products[featured_handle]
  endif

  if featured_product != blank
    assign featured_card_url = featured_product.url
    assign featured_card_title = featured_product.title
    assign featured_image = featured_product.featured_image | default: featured_product.featured_media.preview_image
    assign featured_alt = featured_image.alt | default: featured_product.title | escape
  endif
-%}

{%- unless section_fetch -%}
  <div
    id="MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }}"
    class="list-menu--wrapper header-new-mega-menu header-simple-mega-menu"
    tabindex="-1"
    style="--columns-count: {{ columns_count }}; --gap-x: 2rem; --gap-y: 1.6rem"
  ></div>
{%- else -%}
  <div
    id="MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }}"
    class="list-menu--wrapper header-new-mega-menu header-simple-mega-menu"
    tabindex="-1"
    style="--columns-count: {{ columns_count }}; --gap-x: 2rem; --gap-y: 1.6rem"
  >
    <div class="mega-menu__container page-width page-width--{{ width }} flex items-start justify-between flex-wrap xl:flex-nowrap">
      <ul
        class="mega-menu__list header__mega-submenu{% if link.levels == 1 %} mega-menu__list--condensed{% endif %}"
        role="list"
        id="MegaMenu-List-{{ section.id }}-{{ forloopIndex }}"
      >
        {%- for childlink in link.links -%}
          <li>
            {%- capture childlink_id -%}HeaderMenu-{{ link.handle }}-{{ childlink.handle }}{%- endcapture -%}
            {% render 'header-mega-menu-link',
              menu_link: childlink,
              level: '2',
              id: childlink_id,
              keys: keys,
              sec_settings: sec_settings
            %}
            {%- if childlink.links != blank -%}
              <ul class="list-unstyled" role="list">
                {%- for grandchildlink in childlink.links -%}
                  <li>
                    {%- capture grandchildlink_id -%}HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}{%- endcapture -%}
                    {% render 'header-mega-menu-link',
                      menu_link: grandchildlink,
                      level: '3',
                      id: grandchildlink_id,
                      keys: keys,
                      sec_settings: sec_settings,
                      show_item_image: true
                    %}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if featured_product != blank or side_image != blank -%}
        <aside class="header-simple-mega-menu__aside" aria-label="Featured product">
          <a
            class="mega-menu-feature-card"
            {% if featured_card_url != blank %}
              href="{{ featured_card_url }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            <span class="mega-menu-feature-card__badge">Hot seller</span>
            <span class="mega-menu-feature-card__media">
              {%- if featured_image != blank -%}
                {{
                  featured_image
                  | image_url: width: 640
                  | image_tag:
                    loading: 'lazy',
                    widths: '240, 360, 480, 640',
                    sizes: '(min-width: 990px) 320px, 100vw',
                    alt: featured_alt,
                    class: 'mega-menu-feature-card__image motion-reduce'
                }}
              {%- else -%}
                <span class="mega-menu-feature-card__placeholder">{{ featured_card_title | truncate: 40 }}</span>
              {%- endif -%}
            </span>
            <span class="mega-menu-feature-card__body">
              <span class="mega-menu-feature-card__title">{{ featured_card_title }}</span>
              {%- if featured_product != blank -%}
                <span class="mega-menu-feature-card__price">
                  {% render 'price', product: featured_product, show_unit_price: true %}
                </span>
              {%- endif -%}
              <span class="mega-menu-feature-card__cta">Shop now</span>
            </span>
          </a>
        </aside>
      {%- endif -%}
    </div>
  </div>
{%- endunless -%}

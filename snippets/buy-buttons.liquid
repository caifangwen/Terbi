<div class="product-form__buttons product-form__buttons--single-row">
  <div class="product-form__quantity">
    {% render 'quantity-selector', product: closest.product %}
  </div>

  <div class="product-form__main-action">
    {% render 'product-add-to-cart',
      can_add_to_cart: can_add_to_cart,
      add_to_cart_text: add_to_cart_text,
      style_class: 'button',
      button_style: 'default',
      group_buttons_position: 'right',
      enable_wishlist: true,
      show_social: true,
      gap: 8
    %}
  </div>

  {%- unless gift_card_recipient_feature_active -%}
    <span
      class="product-form-text__error hidden"
      ref="addToCartTextError"
    >
      <span class="svg-wrapper product-form-icon--error">
        {{- 'icon-error.svg' | inline_asset_content -}}
      </span>
    </span>
  {%- endunless -%}
</div>
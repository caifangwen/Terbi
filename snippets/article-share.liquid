{%- liquid
  assign share_url = request.origin | append: article.url
  assign share_title = article.title | url_param_escape
  assign share_image = blank
  if article.image
    assign share_image = article.image | image_url: width: 1200
  endif
-%}

<div class="article-share" aria-label="Share this article">
  <span class="article-share__label">Share</span>
  <div class="article-share__links">
    <a
      class="article-share__link"
      href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_param_escape }}"
      target="_blank"
      rel="noopener noreferrer nofollow"
      aria-label="Share on Facebook"
    >
      <span class="svg-wrapper">{{ 'icon-facebook.svg' | inline_asset_content }}</span>
    </a>
    <a
      class="article-share__link"
      href="https://x.com/share?text={{ share_title }}&amp;url={{ share_url | url_param_escape }}"
      target="_blank"
      rel="noopener noreferrer nofollow"
      aria-label="Share on X"
    >
      <span class="svg-wrapper">{{ 'icon-twitter.svg' | inline_asset_content }}</span>
    </a>
    {%- if share_image != blank -%}
      <a
        class="article-share__link"
        href="https://pinterest.com/pin/create/button/?url={{ share_url | url_param_escape }}&amp;media={{ share_image | url_param_escape }}&amp;description={{ share_title }}"
        target="_blank"
        rel="noopener noreferrer nofollow"
        aria-label="Share on Pinterest"
      >
        <span class="svg-wrapper">{{ 'icon-pinterest.svg' | inline_asset_content }}</span>
      </a>
    {%- endif -%}
    {% unless hide_email %}
    <a
      class="article-share__link"
      href="mailto:?subject={{ share_title }}&amp;body={{ share_url | url_param_escape }}"
      aria-label="Share by email"
    >
      <span class="svg-wrapper">{{ 'icon-mail.svg' | inline_asset_content }}</span>
    </a>
    {% endunless %}
  </div>
</div>

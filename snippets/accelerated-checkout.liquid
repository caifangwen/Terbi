{%- doc -%}
  Displays the accelerated checkout button inside a product form.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param form_obj - The form object

{%- enddoc -%}

{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
%}

{% capture group_buttons %}
  {%- if enable_wishlist -%}
    {% liquid
      assign class_button = 'button h-full center cursor-pointer flex items-center justify-center relative leading-none'
      assign class_text = 'visually-hidden'
      assign class_text_inner = 'text-inner text-sm inline-block'
    %}
    {% render 'product-wishlist-button',
      card_product: closest.product,
      class_button: class_button,
      class_text: class_text,
      class_text_inner: class_text_inner
    %}
  {%- endif -%}
  {%- if show_social -%}
    {% render 'social-share-button'
      product: closest.product
    %}
  {%- endif -%}
{% endcapture %}

{% capture agree_condition %}
  {%- if agree_condition and agree_condition_text != blank -%}
    {% if agree_condition_popup_text != blank %}
      {%- capture agree_condition_popup_text -%}
        <side-drawer-opener
          class="popup agree-condition-popup-modal__opener--keep product-popup-modal__opener--keep"
          data-side-drawer="#PopupModal-{{ id }}"
        >
          <button
            id="PopupModalButton-{{ id }}"
            class="button button-unstyled popup__button"
            type="button"
          >
            {{ agree_condition_popup_text }}
          </button>
        </side-drawer-opener>
        {% if agree_condition_popup_page != blank %}
          <side-drawer
            class="popup__content agree-condition-popup-modal__drawer--keep product-popup-modal__drawer--keep drawer fixed top-0 left-0 z-10 w-screen h-full flex justify-center no-js-hidden"
            element-s-popup
            id="PopupModal-{{ id }}"
          >
            <div id="Drawer-Overlay-{{ id }}" class="drawer__overlay fixed inset-0 cursor-pointer"></div>
            <div
              class="popup__inner color-{{ settings.popover_color_scheme }} w-full h-auto absolute-c-c flex flex-column global-settings-popup"
              role="dialog"
              aria-modal="true"
              aria-label="Agree condition"
              tabindex="-1"
              style="--modal-max-width: 72rem;"
            >
              <button
                onclick="this.closest('side-drawer').close()"
                class="drawer__close block t-button bor-none rounded-full cursor-pointer absolute"
                type="button"
                aria-label="{{ 'accessibility.close_dialog' | t }}"
                style="--top: 0.5rem; --right: 0.5rem;"
              >
                {{- 'icon-close.svg' | inline_asset_content -}}
              </button>
              <div class="w-full h-full overflow-auto cus-scrollbar" style="--p: 2rem 1rem;">
                <div class="drawer__header relative center"
                  style="--p: 1.5rem 0; --mb: 2.5rem;"
                >
                  <h5 class="drawer__heading break m-0">
                    {{ agree_condition_popup_text }}
                  </h5>
                </div>
                <div class="agree-condition-popup-modal__content-info m-auto">
                  {{ agree_condition_popup_page.content }}
                </div>
              </div>
            </div>
          </side-drawer>
        {% endif %}
      {%- endcapture -%}
    {% endif %}

    <div class="spacing-style newsletter-form__checkbox"
      style="--padding-block-start: {{ condition_padding_start }}px; --padding-block-end: {{ condition_padding_end }}px; --padding-inline-start: 0px; --padding-inline-end: 0px;"
    >
      {% assign checkbox_id = id | prepend: 'agree_condition-' %}
      {% if agree_condition_popup_text != blank %}
        {% assign agree_condition_text = agree_condition_text | replace: '[popup_text]', agree_condition_popup_text %}
      {% endif %}
      {% assign agree_condition_label_default = agree_condition_text %}
      {% render 'checkbox', class: 'agree-condition-checkbox', label_content: agree_condition_text, label: agree_condition_label_default, id: checkbox_id, name: checkbox_id, required: true %}
    </div>
  {%- endif -%}
{% endcapture %}

<div
  class="accelerated-checkout-block checkout--{{ style_class }}"
  ref="acceleratedCheckoutButtonContainer"
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
  {% unless can_add_to_cart %}
    hidden
  {% endunless %}
>
  {% if product != blank and form_obj != blank %}
    {% if agree_condition_position == 'top' %}
      {{ agree_condition }}
    {% endif %}
    <div class="add-to-cart-button-inner items-start flex" style="--gap: {{ gap }}px;">
      {% if group_buttons_position == 'left' %}
        {{ group_buttons }}
      {% endif %}
      {{ form_obj | payment_button }}
      {% if group_buttons_position == 'right' %}
        {{ group_buttons }}
      {% endif %}
    </div>
    {% if agree_condition_position == 'bottom' %}
      {{ agree_condition }}
    {% endif %}
  {% endif %}
</div>

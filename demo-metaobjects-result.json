    {
      "id": "gid://shopify/Metaobject/623218098457",
      "type": "faq",
      "handle": "terbi-demo-compatibility",
      "fields": [
        {
          "key": "question",
          "value": "How should I check device compatibility?"
        },
        {
          "key": "answer",
          "value": "For a real purchase, check the connector, supported connection protocols, required power and physical dimensions against your device documentation. The demo does not guarantee compatibility."

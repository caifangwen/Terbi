{% liquid
  assign list_heading = block.settings.heading
  if block.settings.collection_heading
    assign list_heading = collection.metafields.custom.section_content.value.articles_heading.value
  endif
%}
{{ 'component-blog-list.css' | asset_url | stylesheet_tag }}
<div class="guide-blog-list" style="--blog-columns-desktop: {{ block.settings.columns_desktop }}; --blog-columns-tablet: {{ block.settings.columns_tablet }}; --blog-columns-mobile: {{ block.settings.columns_mobile }}; --blog-grid-gap: {{ block.settings.grid_gap }}px; max-width: {{ block.settings.desktop_width_percent }}%; padding-block: {{ block.settings.section_padding }}px;" {{ block.shopify_attributes }}>
  <div class="guide-blog-list__container" style="max-width: {{ block.settings.container_width }}px; margin-inline: auto;">
    {% if list_heading != blank %}
      <h2 style="text-align: {{ block.settings.heading_alignment }}; margin: 0 0 {{ block.settings.heading_spacing }}px;">{{ list_heading }}</h2>
    {% endif %}
    {% if template.suffix == 'gr-guide-and-resorce' and block.settings.blog != blank %}
      <div class="guide-blog-list__toolbar">
        <span>{{ block.settings.blog.articles_count }} articles</span>
        <a href="{{ block.settings.blog.url }}">{{ 'content.view_all' | t }} <span aria-hidden="true">&rarr;</span></a>
      </div>
    {% endif %}
    {% if request.page_type == 'blog' %}
      {% paginate block.settings.blog.articles by block.settings.articles_to_show %}
        <div class="guide-blog-list__grid">
          {% for article in block.settings.blog.articles %}
            {% render 'article-card-static', article: article, blog: block.settings.blog %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          {% render 'pagination', paginate: paginate, section: section %}
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div class="guide-blog-list__grid">
        {% for article in block.settings.blog.articles limit: block.settings.articles_to_show %}
          {% render 'article-card-static', article: article, blog: block.settings.blog %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "博客列表",
  "tag": null,
  "settings": [
    { "type": "checkbox", "id": "collection_heading", "label": "Use collection article heading", "default": false },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "标题",
      "default": "最新文章"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "博客"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "显示文章数量",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "桌面列数",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "平板列数",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "移动端列数",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "网格间距",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "容器最大宽度",
      "min": 1000,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "区块内边距",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "标题对齐",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "标题间距",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "博客列表"
    }
  ]
}
{% endschema %}

    {
      "type": "range",
      "id": "margin-inline-start-mobile-item",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.left_margin_mobile",
      "default": 0,
      "visible_if": "{{ block.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "margin-inline-end-item",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.right",
      "default": 0,
      "visible_if": "{{ block.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "margin-inline-end-mobile-item",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.right_margin_mobile",
      "default": 0,
      "visible_if": "{{ block.settings.heading != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",

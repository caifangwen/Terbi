{% liquid
  assign bl_stts = block.settings
  assign content_source = source | default: block.settings.content_source | default: 'fixed'
  assign faq_items = items
  assign is_item = false

  if faq_items == blank
    case content_source
      when 'selected'
        assign faq_items = block.settings.faq_items
      when 'resource'
        assign faq_items = product.metafields.custom.faq.value | default: collection.metafields.custom.faq.value | default: page.metafields.custom.faq.value | default: article.metafields.custom.faq.value
    endcase
  endif

  if content_source == 'fixed' and bl_stts.heading != blank
    assign is_item = true
  endif
%}

{% capture children %}
  {% if faq_items != blank %}
    {% for faq in faq_items %}
      {% assign question = faq.question.value | default: faq.question %}
      {% capture answer %}{{ faq.answer | metafield_tag }}{% endcapture %}
      {% render 'accordion', heading: question, content: answer, item_class: 'accordion__item faq__item', content_class: 'rte' %}
    {% endfor %}
  {% else %}
    {% content_for 'blocks' %}
  {% endif %}
{% endcapture %}

{% if is_item %}
  {% capture item_style %}{% render 'spacing-style', settings: bl_stts, suffix: 'item' %}{% endcapture %}
  {% capture details_style %}{% if bl_stts.inherit_color_scheme == false %}{% render 'color-scheme-style', settings: bl_stts %}{% endif %}{% endcapture %}
  {% capture summary_style %}{% render 'spacing-style', settings: bl_stts %}{% endcapture %}
  {% assign details_class = '' %}
  {% if bl_stts.inherit_color_scheme == false %}{% assign details_class = 'color-scheme-custom' %}{% endif %}
  {% render 'accordion', heading: bl_stts.heading, content: children, open: bl_stts.open_by_default, item_class: 'block spacing-style accordion__item', item_style: item_style, details_class: details_class, details_style: details_style, summary_class: 'spacing-style', summary_style: summary_style, attributes: block.shopify_attributes %}
{% else %}
  <div
    class="accordion accordion--{{ bl_stts.icon | default: 'caret' }} border-style spacing-style{% if bl_stts.inherit_color_scheme == false %} color-scheme-custom{% endif %}{% if bl_stts.dividers %} accordion--dividers{% endif %}"
    style="
      --summary-font-family: var(--font-{{ bl_stts.type_preset_heading }}--family);
      --summary-font-style: var(--font-{{ bl_stts.type_preset_heading }}--style);
      --summary-font-weight: var(--font-{{ bl_stts.type_preset_heading }}--weight);
      --summary-font-size: var(--font-{{ bl_stts.type_preset_heading }}--size);
      --summary-font-line-height: var(--font-{{ bl_stts.type_preset_heading }}--line-height);
      --summary-font-case: var(--font-{{ bl_stts.type_preset_heading }}--case);
      {% render 'spacing-style', settings: bl_stts %}
      {% render 'border-override', settings: bl_stts %}
      {% if bl_stts.inherit_color_scheme == false %}
        {% render 'color-scheme-style', settings: bl_stts %}
      {% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {{ children }}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.accordion",
  "tag": null,
  "class": "accordion",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "content_source",
      "label": "Content source",
      "options": [
        { "value": "fixed", "label": "Manual items" },
        { "value": "resource", "label": "Current resource FAQ" },
        { "value": "selected", "label": "Selected FAQ entries" }
      ],
      "default": "fixed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "visible_if": "{{ block.settings.content_source == 'fixed' }}"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false,
      "visible_if": "{{ block.settings.heading != blank }}"
    },
    {
      "type": "metaobject_list",
      "id": "faq_items",
      "label": "FAQ entries",
      "metaobject_type": "faq",
      "limit": 50
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "caret",
          "label": "t:options.caret"
        },
        {
          "value": "plus",
          "label": "t:options.plus"
        }
      ],
      "default": "caret"
    },
    {
      "type": "checkbox",
      "id": "dividers",
      "label": "t:settings.dividers",
      "default": true
    },
    {
      "type": "select",
      "id": "type_preset_heading",
      "label": "t:settings.heading_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "h6",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color",
      "id": "scheme_background",
      "label": "t:settings.background",
      "default": "#FFFFFF",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color_background",
      "id": "scheme_background_gradient",
      "label": "t:settings.background_gradient",
      "info": "t:info.background_gradient_info",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_foreground_heading",
      "label": "t:settings.headings",
      "default": "#000000",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_foreground",
      "label": "t:settings.text",
      "default": "#000000",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_primary",
      "label": "t:settings.primary_color",
      "default": "#000F9F",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_primary_hover",
      "label": "t:settings.primary_hover_color",
      "default": "#000000",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_border",
      "label": "t:settings.borders",
      "default": "#E6E6E6",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_shadow",
      "label": "t:settings.shadow_color",
      "default": "#000000",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:content.margin",
      "visible_if": "{{ block.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "margin-block-start-item",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.top",
      "default": 0,
      "visible_if": "{{ block.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "margin-block-start-mobile-item",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",

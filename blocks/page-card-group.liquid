<ul
  class="page-card-group__grid"
  role="list"
  style="
    --page-card-columns: {{ block.settings.columns_grid }};
    --page-card-tablet-columns: {{ block.settings.tablet_columns_grid }};
    --page-card-mobile-columns: {{ block.settings.mobile_columns_grid }};
    --page-card-row-gap: {{ block.settings.vertical_gap }}px;
    --page-card-column-gap: {{ block.settings.column_gap }}px;
  "
  {{ block.shopify_attributes }}
>
  {% for child_block in block.blocks %}
    <li class="page-card-group__item">
      {% render child_block %}
    </li>
  {% endfor %}
</ul>

{% schema %}
{
  "name": "Page card group",
  "tag": null,
  "blocks": [
    {
      "type": "group"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "columns_grid",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "tablet_columns_grid",
      "label": "Tablet columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "mobile_columns_grid",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "vertical_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Page card group"
    }
  ]
}
{% endschema %}
